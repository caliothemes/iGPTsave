{
  "name": "EffectCategory",
  "type": "object",
  "properties": {
    "id_slug": {
      "type": "string",
      "description": "Identifiant unique (slug)"
    },
    "name_fr": {
      "type": "string",
      "description": "Nom en fran\u00e7ais"
    },
    "name_en": {
      "type": "string",
      "description": "Nom en anglais"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
