{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Titre de la conversation"
    },
    "visual_id": {
      "type": "string",
      "description": "ID du visuel cr\u00e9\u00e9 dans cette conversation"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "user_email"
  ]
}