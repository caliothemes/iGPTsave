{
  "name": "Newsletter",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de la newsletter"
    },
    "template_id": {
      "type": "string",
      "description": "ID du template utilis\u00e9"
    },
    "subject": {
      "type": "string",
      "description": "Sujet de l'email"
    },
    "html_content": {
      "type": "string",
      "description": "Contenu HTML final g\u00e9n\u00e9r\u00e9"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sent"
      ],
      "default": "draft"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'envoi"
    },
    "recipients_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de destinataires"
    },
    "created_by": {
      "type": "string",
      "description": "Email de l'admin cr\u00e9ateur"
    }
  },
  "required": [
    "title",
    "template_id",
    "subject"
  ]
}