{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "credit_pack",
        "subscription_limited",
        "subscription_unlimited"
      ]
    },
    "amount": {
      "type": "number"
    },
    "credits_added": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "user_email",
    "type",
    "amount"
  ]
}