{
  "name": "VideoExample",
  "type": "object",
  "properties": {
    "title_fr": {
      "type": "string",
      "description": "Titre de l'exemple en fran\u00e7ais"
    },
    "title_en": {
      "type": "string",
      "description": "Titre de l'exemple en anglais"
    },
    "image_url": {
      "type": "string",
      "description": "URL de l'image de d\u00e9part"
    },
    "image_url_2": {
      "type": "string",
      "description": "URL de la deuxi\u00e8me image de d\u00e9part (optionnel)"
    },
    "prompt": {
      "type": "string",
      "description": "Prompt utilis\u00e9 pour g\u00e9n\u00e9rer la vid\u00e9o"
    },
    "video_url": {
      "type": "string",
      "description": "URL de la vid\u00e9o g\u00e9n\u00e9r\u00e9e"
    },
    "provider": {
      "type": "string",
      "enum": [
        "replicate",
        "runway",
        "wan"
      ],
      "description": "Provider utilis\u00e9 pour g\u00e9n\u00e9rer la vid\u00e9o"
    },
    "duration": {
      "type": "number",
      "description": "Dur\u00e9e de la vid\u00e9o en secondes"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordre d'affichage"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "image_url",
    "prompt",
    "video_url"
  ]
}