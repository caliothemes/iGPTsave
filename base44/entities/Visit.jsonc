{
  "name": "Visit",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur (ou 'anonymous' si non connect\u00e9)"
    },
    "page": {
      "type": "string",
      "description": "Page visit\u00e9e"
    },
    "user_agent": {
      "type": "string",
      "description": "User agent du navigateur"
    },
    "device": {
      "type": "string",
      "enum": [
        "desktop",
        "mobile",
        "tablet"
      ],
      "description": "Type d'appareil"
    },
    "session_id": {
      "type": "string",
      "description": "ID de session unique"
    }
  },
  "required": [
    "page"
  ]
}